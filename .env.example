# Upwork Creative Pipeline - Environment Variables
# Copy this file to .env and fill in your real values
# Never commit .env to git

# Anthropic API key (for copy generation in Stage 02)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API key (for image generation in Stage 04)
GEMINI_API_KEY=your_gemini_api_key_here

# Figma personal access token (for Stage 05 assembly)
FIGMA_ACCESS_TOKEN=your_figma_token_here

# Google service account JSON file path (for Drive read/write in Stages 01 and 06)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# S3 bucket for run artifacts (only needed for Lambda/cloud deployment)
RUNS_BUCKET=upwork-adam-runs-alpha

# LLM Gateway (Upwork internal - leave blank for local dev, uses direct Anthropic API instead)
LLM_GATEWAY_ENDPOINT=
LLM_GATEWAY_MODEL=

# MindStudio webhook (leave blank for local dev)
MIND_STUDIO_WEBHOOK_URL=

# Webhook secret for validating incoming requests
WEBHOOK_SECRET=

# Slack webhook for notifications
SLACK_WEBHOOK_URL=
