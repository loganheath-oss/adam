# ADAM environment template — REGENERATED from actual os.environ reads
# (2026-07-31 audit: the old template was two architectures stale and
# omitted PIPELINE_API_KEY entirely — bootstrapping from it left /mcp
# auth OFF). Regenerate: see docs/OPEN-ITEMS.md.

# Claude API key — copy generation, review, chat agent (REQUIRED)
ANTHROPIC_API_KEY=

# Gemini key — image generation for non-people styles (REQUIRED for image sprints)
GEMINI_API_KEY=

# Figma API token — photo library reads + template harvests (REQUIRED)
FIGMA_ACCESS_TOKEN=

# Admin/API key for protected endpoints. UNSET = /mcp and admin routes fail OPEN — always set it (REQUIRED)
PIPELINE_API_KEY=

# Dedicated MCP connector token (falls back to PIPELINE_API_KEY if unset — set it so the admin key stays out of connector URLs)
MCP_AUTH_TOKEN=

# Postgres — events, issues, off-volume backups (Railway injects; REQUIRED in prod)
DATABASE_URL=

# Sprint storage root. Railway: /data/runs (persistent volume). Local default: ./runs
RUNS_DIR=

# Bearer token for the Hightouch inbound integration (unset = integration disabled, fails closed)
HIGHTOUCH_API_KEY=

# Comma-separated admin emails for the dashboard
ADMIN_EMAILS=

# Chat agent model (default claude-sonnet-5)
ADAM_CHAT_MODEL=

# Chat output budget (default 16000 — a full gate presentation needs 6-8k)
ADAM_CHAT_MAX_TOKENS=

# Selection floor per style (default 2 — Adrie's top-2 spec)
ADAM_MIN_CHOICES=

# Per-image cost estimate for spend tracking (default 0.13)
ADAM_IMAGE_COST_USD=

# Free-disk floor before new work is refused (default 60)
ADAM_MIN_FREE_MB=

# Max seconds a webhook deploy waits for in-flight sprints (default 1800)
ADAM_DEPLOY_DRAIN_MAX_S=

# Parallel copy-generation calls (default 5)
COPY_CONCURRENCY=

# Set to 'http' only for standalone MCP testing (normally mounted in the web app)
MCP_TRANSPORT=

# Host allowlist for MCP DNS-rebinding protection
MCP_ALLOWED_HOSTS=

# Override for the Paid Acquisition Figma file id
FIGMA_FILE_ID=

# HTTP port (Railway injects)
PORT=

# Additional tunables (see code for context):
# ADAM_COPY_MODEL=   (read by: pipeline/run_pipeline.py)
# ADAM_COPY_THINKING=   (read by: pipeline/run_pipeline.py)
# ADAM_MONTHLY_BUDGET_USD=   (read by: main.py)
# COPY_BATCH_SIZE=   (read by: pipeline/run_pipeline.py)
# MIND_STUDIO_WEBHOOK_URL=   (read by: pipeline/00_intake.py)
# PIPELINE_WORKERS=   (read by: main.py)
# QUOTES_PATH=   (read by: main.py, pipeline/run_pipeline.py)
# RAILWAY_DEPLOYMENT_ID=   (read by: main.py)
# RAILWAY_GIT_AUTHOR=   (read by: main.py)
# RAILWAY_GIT_BRANCH=   (read by: main.py)
# RAILWAY_GIT_COMMIT_MESSAGE=   (read by: main.py)
# RAILWAY_GIT_COMMIT_SHA=   (read by: main.py)
# RAILWAY_SERVICE_NAME=   (read by: main.py)
# RUNS_BUCKET=   (read by: pipeline/00_intake.py)
# WEBHOOK_SECRET=   (read by: main.py, pipeline/00_intake.py)
